{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/cerebral_singleton_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking Singleton Systems map"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/cerebral_singleton_guard.py\"",
            "timeout": 10,
            "statusMessage": "Loading Singleton Systems map"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/cerebral_singleton_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking outbound writing"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/cerebral_singleton_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking Cerebral route"
          }
        ]
      },
      {
        "matcher": "^(?:mcp__codex_apps__figma_(?:use_figma|weave_run_tool|export_video)|mcp__premiere_pro__(?:import_media|add_to_timeline|insert_from_source|overwrite_clip|overwrite_from_source|replace_clip|replace_clip_media|move_clip|move_clip_to_track|set_clip_start_time|trim_clip|add_transition|add_transition_to_clip|batch_add_transitions|add_adjustment_layer|apply_audio_effect|apply_audio_effect_to_all_clips|apply_effect|batch_apply_effect|color_correct|crop_clip|set_blend_mode|set_effect_property|apply_lut|set_clip_opacity|set_clip_properties|delete_multiple_project_items|delete_project_item|extract_selection|lift_selection|razor_all_tracks|razor_timeline_at_time|remove_from_timeline|remove_selected_clips|ripple_delete))$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/lineups_enforcement.py\"",
            "timeout": 10,
            "statusMessage": "Checking Lineups transaction"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/cerebral_singleton_guard.py\"",
            "timeout": 10,
            "statusMessage": "Scanning Singleton Systems drift"
          }
        ]
      },
      {
        "matcher": "^(?:mcp__codex_apps__figma_(?:use_figma|export_video)|mcp__premiere_pro__(?:import_media|add_to_timeline|get_project_item_info|find_items_by_media_path|get_full_sequence_info|get_clip_properties))$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/lineups_enforcement.py\"",
            "timeout": 10,
            "statusMessage": "Verifying Lineups transaction readback"
          }
        ]
      }
    ]
  }
}
