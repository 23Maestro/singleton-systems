# dependencies
/node_modules

# next.js
/.next
/out

# generated visual maps
/docs/visual-maps/dist
/docs/visual-maps/archive

# FaithTalk working media and generated outputs stay outside Git/Codex snapshots.
# Keep compositions, HTML, scripts, manifests, and documentation visible.
/videos/faithtalk-drawn-seed-preview/assets/
/videos/faithtalk-drawn-seed-preview/renders/
/videos/faithtalk-drawn-seed-preview/references/
/videos/faithtalk-drawn-seed-preview/snapshots/
/videos/faithtalk-drawn-seed-preview/.hyperframes/
/videos/faithtalk-drawn-seed-preview/.thumbnails/
/videos/faithtalk-logo-reveal/renders/
/videos/faithtalk-logo-reveal/.hyperframes/
/videos/faithtalk-logo-reveal/.thumbnails/

# Understand Anything local graph data; keep the scan boundary
/.ua/*
!/.ua/.understandignore

# production
/build

# misc
.DS_Store
*.pem
/output
/tmp
.tmp
.cache
.scratch/review-artifacts/
.playwright-cli
.playwright-mcp/
__pycache__/
*.pyc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
.claude/
playwright-report
test-results
blob-report
coverage

# local env files
.env*.local
.env

# Google Workspace local OAuth
.google-workspace/
config/google-workspace/*.json
!config/google-workspace/*.example.json

# supabase local metadata
supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo

# progress dashboards
.dashboard/

