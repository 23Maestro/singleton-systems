{
  "manifestVersion": 5,
  "id": "com.singletonsystems.cutter",
  "name": "Bad Take Remover",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "cutterPanel",
      "label": { "default": "Bad Take Remover" },
      "minimumSize": { "width": 320, "height": 360 },
      "preferredDockedSize": { "width": 380, "height": 620 },
      "preferredFloatingSize": { "width": 420, "height": 680 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "allowCodeGenerationFromStrings": false
  },
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/light.svg",
      "scale": [1, 2],
      "theme": ["lightest", "light", "dark", "darkest"]
    }
  ]
}
