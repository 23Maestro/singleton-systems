{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singleton.systems/schemas/transaction-owner-map.json",
  "type": "object",
  "required": ["version", "stateOwners", "flows"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "stateOwners": { "type": "object", "minProperties": 1 },
    "flows": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/flow" }
    }
  },
  "$defs": {
    "flow": {
      "type": "object",
      "required": ["lane", "route", "intent", "reviewGates", "owners"],
      "properties": {
        "lane": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "minLength": 1 },
        "intent": { "type": "string", "minLength": 1 },
        "reviewGates": { "type": "array" },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/owner" }
        }
      }
    },
    "owner": {
      "type": "object",
      "required": ["ownerId", "uri", "required", "dependsOn", "adapter"],
      "properties": {
        "ownerId": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "dependsOn": { "type": "array", "items": { "type": "string" } },
        "reviewGateId": { "type": ["string", "null"] },
        "adapter": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": [
                "path-snapshot",
                "directory-parity",
                "command-readback",
                "git-state",
                "task-catalog"
              ]
            }
          }
        }
      }
    }
  }
}
