  "components": {
    "geometry": {
      "svgBevelLogo": {
        "what": "Team mark as a real 3D object",
        "blender": "SVG import, extrude, convert to mesh, Bevel modifier with clamp overlap and harden normals, Weighted Normal",
        "builtIn": true,
        "lesson": "Never use curve bevel on logos; it spikes on sharp tips (Chiefs arrowhead)."
      },
      "facetedShards": {
        "what": "Gem or crystal shard wall",
        "blender": "Geometry Nodes Voronoi fracture of a plane into many small facets, per-facet random tilt and depth, Bevel on edges",
        "builtIn": true,
        "alternative": "Cell Fracture extension (needs install from extensions.blender.org)"
      },
      "chevronTread": {
        "what": "Center spine of stacked shallow V bands",
        "blender": "Generated V-band mesh, Solidify, rounded Bevel",
        "builtIn": true,
        "measuredFromReference": {
          "widthShareOfFrame": 0.15,
          "vAngleDeg": 14,
          "bandToPitch": 0.74
        }
      },
      "cutoutCard": {
        "what": "Player cutout in the set",
        "blender": "Image plane with hard alpha threshold at 0.5",
        "builtIn": true,
        "lesson": "Soft dithered alpha speckles edges at 1080p; threshold the alpha."
      },
      "slab": {
        "what": "Nameplates, tables, plates",
        "blender": "Polygon from points, Solidify, Bevel",
        "builtIn": true
      }
    },
    "materials": {
      "teamBrushedMetal": {
        "base": "team color at 0.35 to 0.95 value",
        "maps": [
          "tex.Metal009:Roughness",
          "tex.Metal009:NormalGL",
          "tex.Metal038:Roughness (mix)"
        ],
        "metallic": 0.75,
        "anisotropic": 0.7
      },
      "chevronRubber": {
        "base": "#08090b",
        "maps": [
          "tex.Rubber004:NormalGL",
          "tex.Rubber004:Roughness"
        ],
        "roughness": 0.5
      },
      "chromeType": {
        "base": "#ffffff",
        "metallic": 1.0,
        "roughness": 0.15,
        "needs": "hdri.studio_small_03"
      },
      "glossyPlate": {
        "base": "team color",
        "coat": 1.0,
        "roughness": 0.2
      },
      "satin": {
        "roughness": 0.45,
        "coat": 0.0
      },
      "darkGlassPanel": {
        "base": "#0b0c0f",
        "coat": 0.6,
        "maps": [
          "tex.Fingerprints009:Roughness"
        ],
        "lesson": "Glossy panels mirror square area lights as white boxes; use round or soft lights near them."
      },
      "logoTeamColors": {
        "rule": "Keep the real logo colors; tint at most 0.35 toward a dark team tone. Let the rim light add the sheen.",
        "lesson": "A 0.9 tint washed the Chiefs white into pink and maroon."
      }
    },
    "environment": {
      "worldHdri": {
        "default": "hdri.studio_small_03",
        "useFor": "reflections and soft fill; hide from camera with Film Transparent or a dark world strength for the backdrop"
      },
      "haze": {
        "density": 0.0022,
        "lesson": "Fill and top lights must have volume_factor 0, or they paint a grey cone over the set."
      }
    },
    "post": {
      "bloom": {
        "blender": "Compositor Glare node, Bloom or Fog Glow",
        "builtIn": true,
        "renderAsSeparateLayer": true
      },
      "flash": {
        "blender": "Compositor Glare Streaks or Sun Beams",
        "builtIn": true
      },
      "chromaticAberration": {
        "blender": "Compositor Lens Distortion with dispersion, transitions only",
        "builtIn": true
      },
      "zoomBlur": {
        "blender": "Compositor Directional Blur with zoom",
        "builtIn": true
      },
      "grain": {
        "where": "final comp only"
      },
      "colorView": {
        "view": "Standard",
        "adr": "docs/broadcast-engine/adr/0003-standard-view-for-team-colors.md"
      }
    },
    "engines": {
      "eevee": {
        "for": "players, type, logos, motion, most sets",
        "limits": "screen-space reflections only"
      },
      "cycles": {
        "for": "gem facets, glass, ice, chrome that reflects chrome",
        "costVsEevee": "about 3 to 10 times per frame",
        "pattern": "render the background plate once per team pair in Cycles; everything else in EEVEE"
      }
    }
  },
